{
  "env": {
    "CLAUDE_MEM_TELEMETRY": "0"
  },
  "enabledPlugins": {
    "taste-skill@clinicfinder-plugins": true,
    "ui-ux-pro-max@clinicfinder-plugins": true,
    "caveman@caveman": true,
    "godmode@godmode": true,
    "claude-mem@thedotmack": true,
    "agent-sdk-dev@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "commit-commands@claude-code-plugins": true,
    "explanatory-output-style@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "frontend-design@claude-code-plugins": true,
    "hookify@claude-code-plugins": true,
    "learning-output-style@claude-code-plugins": true,
    "plugin-dev@claude-code-plugins": true,
    "pr-review-toolkit@claude-code-plugins": true,
    "ralph-loop@claude-code-plugins": true,
    "security-guidance@claude-code-plugins": true,
    "ecc@ecc": true
  },
  "extraKnownMarketplaces": {
    "clinicfinder-plugins": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "juliusbrussee/caveman"
      }
    },
    "godmode": {
      "source": {
        "source": "github",
        "repo": "noobygains/godmode"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ecc"
      }
    }
  }
}
